---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const latest = (await getCollection('blog', ({ data }) => !data.draft && data.date <= new Date()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long' });
---
<Base
  title="Irena Poslušná – finanční poradkyně Praha | pojištění rodin, hypotéky, penze"
  description="Finanční poradkyně v Praze. Pomáhám rodinám s pojištěním, hypotékou a spořením. Deset let praxe, schůzka nic nestojí, v kanceláři v Praze 4 i online."
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <h1>Pomáhám rodinám dát do pořádku pojistky a peníze</h1>
        <p class="lead">Jsem Irena Poslušná a deset let pomáhám lidem v Praze a okolí s pojištěním, hypotékou a spořením. Projdeme spolu, co máte, a řeknu vám, co bych nechala a co změnila.</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={`tel:${site.phoneIntl}`}>Zavolat {site.phoneDisplay}</a>
          <a class="text-link" href="/kontakt/">nebo mi napište</a>
        </div>
        <p class="facts">10 let praxe · stovky klientů · Praha 4 i online · <a href={site.cnbRegistryUrl} target="_blank" rel="noopener">zapsaná v registru ČNB</a></p>
      </div>
      <div class="hero__photo">
        <picture>
          <source srcset="/img/irena-poslusna-portret-800.webp 800w, /img/irena-poslusna-portret-1200.webp 1200w" sizes="(min-width: 900px) 420px, 90vw" type="image/webp" />
          <img src="/img/irena-poslusna-portret-800.jpg" width="800" height="1200" alt="Irena Poslušná, finanční poradkyně Praha" fetchpriority="high" />
        </picture>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2>S čím za mnou lidé chodí</h2>
      <div class="plain-grid">
        <div>
          <h3>Pojištění rodiny</h3>
          <p>Nejčastěji kontroluji smlouvy, které lidé mají doma léta. Často platí za drobnosti a na to důležité, třeba na invaliditu, mají pojištěno málo.</p>
          <a class="text-link" href="/revize-pojisteni/">Jak probíhá kontrola pojistek →</a>
        </div>
        <div>
          <h3>Hypotéka</h3>
          <p>Porovnám nabídky bank a pohlídám vám konec fixace. Poradím si i s příjmy OSVČ, se kterými to na pobočce nejde hladce.</p>
          <a class="text-link" href="/sluzby/#hypoteky">Víc o hypotékách →</a>
        </div>
        <div>
          <h3>Spoření a penze</h3>
          <p>Penzijko, investice, spoření pro děti. U každého návrhu vám předem řeknu, kolik stojí a jaké má riziko.</p>
          <a class="text-link" href="/sluzby/#investice">Víc o spoření →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-col">
      <div>
        <h2>Jak to u mě probíhá</h2>
        <ol class="simple-steps">
          <li>Zavoláte nebo napíšete, s čím potřebujete pomoct.</li>
          <li>Sejdeme se asi na hodinu, v kanceláři nebo online, a projdeme, co máte.</li>
          <li>Dostanete ode mě návrh a rozhodnete se v klidu doma.</li>
        </ol>
        <p class="muted">Na schůzku stačí vzít smlouvy, které máte, nebo mi je předem vyfotit.</p>
      </div>
      <div>
        <h2>Jak jsem placená</h2>
        <p>Za schůzky ode mě nic neplatíte. Odměnu mi dává pojišťovna nebo banka, a to jen tehdy, když si u mě něco sjednáte. Smlouva vás stojí stejně, jako kdybyste šli napřímo.</p>
        <p>Když je vaše smlouva v pořádku, řeknu vám to, i když na tom nic nevydělám.</p>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container two-col two-col--wide" style="align-items:center">
      <div>
        <h2>Kdo jsem</h2>
        <p>Začínala jsem v Allianz, dnes pracuji jako vázaná zástupkyně {site.company} Díky tomu můžu porovnat nabídky víc pojišťoven a bank, ne jen jedné.</p>
        <p>Sama mám manžela a děti. Vím, jak je důležité, aby se rodina nepoložila, když něco nevyjde. A vím taky, že na papíry od pojišťovny se člověk dostane až večer, pokud vůbec.</p>
        <a class="text-link" href="/o-mne/">Víc o mně →</a>
      </div>
      <div class="photo-rounded">
        <picture>
          <source srcset="/img/irena-poslusna-konzultace-1200.webp" type="image/webp" />
          <img src="/img/irena-poslusna-konzultace-1200.jpg" width="1200" height="800" alt="Irena Poslušná u pracovního stolu" loading="lazy" />
        </picture>
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section section--tint">
      <div class="container">
        <h2>Z blogu</h2>
        <ul class="post-list">
          {latest.map((p) => (
            <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> <span class="muted small">{fmt(p.data.date)}</span></li>
          ))}
        </ul>
        <a class="text-link" href="/blog/">Všechny články →</a>
      </div>
    </section>
  )}

  <Cta />
</Base>
