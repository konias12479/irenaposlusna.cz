---
import Base from '../layouts/Base.astro';
---
<Base title="Stránka nenalezena | Irena Poslušná" description="Tato stránka neexistuje." noindex={true}>
  <section class="section section--white">
    <div class="container" style="max-width:720px">
      <h1>Tuhle stránku nemám</h1>
      <p class="lead">Odkaz je nejspíš starý nebo v něm je překlep.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Na úvodní stránku</a>
        <a class="btn btn--secondary" href="/kontakt/">Kontakt</a>
      </div>
    </div>
  </section>
</Base>
