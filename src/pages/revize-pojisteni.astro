---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Revize pojistných smluv pro rodiny',
  serviceType: 'Revize pojištění',
  provider: { '@id': `${site.domain}/#business` },
  areaServed: 'Praha a Středočeský kraj',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CZK', description: 'Revize pojistných smluv bez poplatku, včetně písemného Semaforu pojištění.' },
};
---
<Base
  title="Revize pojištění Praha – kontrola pojistných smluv pro rodiny | Irena Poslušná"
  description="Projdu pojistky vaší rodiny a dostanete písemný Semafor: co je v pořádku, co upravit a co chybí. Revize nic nestojí. Praha 4 i online."
  jsonLd={serviceLd}
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <h1>Kontrola pojistek pro rodiny</h1>
        <p class="lead">Přineste smlouvy nebo mi je vyfoťte. Za hodinu víte, co vás opravdu chrání a za co platíte zbytečně.</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={`tel:${site.phoneIntl}`}>Zavolat {site.phoneDisplay}</a>
          <a class="text-link" href="/kontakt/">nebo mi napište</a>
        </div>
        <p class="facts">Revize nic nestojí a k ničemu vás nezavazuje.</p>
      </div>
      <div class="photo-rounded">
        <picture>
          <source srcset="/img/irena-poslusna-konzultace-1200.webp" type="image/webp" />
          <img src="/img/irena-poslusna-konzultace-1200.jpg" width="1200" height="800" alt="Irena Poslušná prochází pojistné smlouvy" fetchpriority="high" />
        </picture>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container two-col">
      <div>
        <h2>Co dostanete</h2>
        <p>Písemný přehled, kterému říkám Semafor. Každé riziko v něm má jednu barvu.</p>
        <div class="semafor">
          <div class="g"><i></i><div><strong>Zelená</strong>Je to v pořádku, nechte to být.</div></div>
          <div class="a"><i></i><div><strong>Oranžová</strong>Stačí drobná úprava.</div></div>
          <div class="r"><i></i><div><strong>Červená</strong>Něco důležitého chybí, nebo přeplácíte.</div></div>
        </div>
      </div>
      <div>
        <h2>Co projdeme</h2>
        <p>Smrt, invaliditu, pracovní neschopnost, vážné nemoci, úraz dětí, domácnost s nemovitostí a odpovědnost za škodu.</p>
        <h2 style="margin-top:1.2em">Kdy to má smysl</h2>
        <ul class="plain-list">
          <li>čekáte dítě nebo se vám narodilo</li>
          <li>berete hypotéku nebo se stěhujete</li>
          <li>přišlo zdražení pojistky</li>
          <li>váš poradce skončil</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container" style="max-width:820px">
      <h2>Kde je háček?</h2>
      <p>Žádný. Odměnu mi platí pojišťovna, a jen když si u mě něco sjednáte. Když je vaše smlouva dobrá, řeknu vám, ať si ji necháte.</p>
      <p style="margin:0">A nic nerušíme naslepo. Starší smlouvy mívají výhody, které nová pojistka už nedá.</p>
    </div>
  </section>

  <Cta title="Pošlete mi pojistku, kterou máte nejdéle" text="Do dvou pracovních dnů vám napíšu, co kryje, co ne a jestli má smysl ji řešit." />
</Base>
