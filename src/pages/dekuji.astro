---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Děkuji za zprávu | Irena Poslušná" description="Vaše zpráva dorazila. Ozvu se do 48 hodin v pracovní dny." noindex={true}>
  <section class="section section--white">
    <div class="container" style="max-width:720px">
      <span class="eyebrow">Zpráva odeslána</span>
      <h1>Děkuji, ozvu se {site.responseTime}</h1>
      <p class="lead">Zavolám vám z čísla {site.phoneDisplay}. Domluvíme se na 15 minutách po telefonu, nic nepodepisujete a nic nechystáte.</p>
      <p>Mezitím se můžete podívat, <a href="/revize-pojisteni/">jak probíhá revize pojistek</a>, nebo si přečíst <a href="/blog/">články na blogu</a>.</p>
      <a class="btn btn--secondary" href="/">Zpět na úvod</a>
    </div>
  </section>
</Base>
