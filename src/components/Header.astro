---
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label="Irena Poslušná, úvodní stránka">
      <span class="brand__mark" aria-hidden="true">IP</span>
      <span>
        <span class="brand__name">Irena Poslušná</span>
        <span class="brand__sub">finanční poradkyně · Praha a okolí</span>
      </span>
    </a>
    <nav class="nav" aria-label="Hlavní menu">
      {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="btn btn--primary header__cta" href={`tel:${site.phoneIntl}`}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
      {site.phoneDisplay}
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-mobile" id="nav-toggle">Menu</button>
  </div>
  <nav class="nav-mobile" id="nav-mobile" data-open="false" aria-label="Mobilní menu">
    {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.getAttribute('data-open') === 'true';
    menu?.setAttribute('data-open', String(!open));
    btn.setAttribute('aria-expanded', String(!open));
    btn.textContent = open ? 'Menu' : 'Zavřít';
  });
</script>
