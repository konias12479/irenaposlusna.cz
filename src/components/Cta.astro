---
import { site } from '../data/site';
interface Props { title?: string; text?: string; }
const {
  title = 'Ozvěte se',
  text = 'Stačí zavolat nebo napsat pár řádků o tom, co řešíte. Sejdeme se v kanceláři v Praze 4 nebo online.',
} = Astro.props;
---
<section class="section cta-light">
  <div class="container">
    <div class="cta-light__box">
      <div class="cta-light__text">
        <p class="eyebrow">Další krok</p>
        <h2>{title}</h2>
        <p class="lead">{text}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={`tel:${site.phoneIntl}`}>Zavolat {site.phoneDisplay}</a>
          <a class="btn btn--secondary btn--lg" href="/kontakt/">Napište mi</a>
        </div>
        <p class="microcopy">Schůzka nic nestojí. Ozvu se {site.responseTime}.</p>
      </div>
      <div class="cta-light__photo">
        <picture>
          <source srcset="/img/irena-poslusna-portret-800.webp" type="image/webp" />
          <img src="/img/irena-poslusna-portret-800.jpg" width="800" height="1200" alt="Irena Poslušná, finanční poradkyně Praha" loading="lazy" />
        </picture>
      </div>
    </div>
  </div>
</section>
