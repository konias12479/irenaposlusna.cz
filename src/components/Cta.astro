---
import { site } from '../data/site';
interface Props { title?: string; text?: string; }
const {
  title = 'Ozvěte se',
  text = 'Stačí zavolat nebo napsat pár řádků o tom, co řešíte. Sejdeme se v kanceláři v Praze 4 nebo online.',
} = Astro.props;
---
<section class="cta-band">
  <div class="cta-band__bg" aria-hidden="true">
    <picture>
      <source srcset="/img/irena-poslusna-konzultace-1800.webp" type="image/webp" />
      <img src="/img/irena-poslusna-konzultace-1200.jpg" width="1200" height="800" alt="" loading="lazy" />
    </picture>
  </div>
  <div class="container">
    <div class="cta-band__inner">
      <h2>{title}</h2>
      <p class="lead">{text}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={`tel:${site.phoneIntl}`}>Zavolat {site.phoneDisplay}</a>
        <a class="btn btn--ghost-light btn--lg" href="/kontakt/">Napište mi</a>
      </div>
      <p class="microcopy">Ozvu se {site.responseTime}.</p>
    </div>
  </div>
</section>
